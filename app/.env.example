# Skopiuj do .env albo .env.local i wstaw swój klucz (te pliki nie trafiają do gita).
# RPC_URL (bez prefiksu VITE_) zostaje po stronie serwera: lokalnie czyta go proxy Vite,
# na Vercel funkcja api/rpc.ts (ustaw tę samą zmienną w Project → Settings → Environment Variables).
# Bez tej zmiennej używany jest publiczny RPC devnetu (niskie limity, błędy 429).
RPC_URL=https://devnet.helius-rpc.com/?api-key=TWOJ_KLUCZ

# Opcjonalnie: WebSocket do potwierdzeń transakcji (bez klucza, trafia do przeglądarki).
# VITE_WS_URL=wss://api.devnet.solana.com
